{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "QueueName": "imageflow_queue",
    "Username": "guest",
    "Password": "guest",
    "UseSsl": false
  },
  "Processing": {
    "ChunkSizeKb": 1024,
    "InputFolder": "InputImages",
    "OutputFolder": "ProcessedImages",
    "MaxRetries": 3,
    "RetryDelayMs": 1000,
    "SupportedImageExtensions": ["png", "jpg", "jpeg", "bmp", "tif", "tiff"]
  },
  "Ocr": {
    "TesseractPath": "C:\\Program Files\\Tesseract-OCR\\tessdata",
    "Language": "eng",
    "MaxConcurrentOperations": 4
  }
} 